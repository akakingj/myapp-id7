{
  "id": "car_profile",
  "title": "Car profile",
  "description": "One place for the car's engine values and units: the redline, rev scale, cold rev limit, shift lights, warm-up and too-hot temperatures and the speed, distance, temperature, pressure, fuel use, torque and power units. M Vitals, Redline, Warm-Up, Virtual Dyno, Drag Timer, Brake Test, G-Force, eDrive and Transmission Config follow them; what is left to each app stays as each app has it",
  "version": "1.6.1",
  "vendor": "custom",
  "loggingId": "OAA9",
  "iconGlyph": "profile",
  "mguHmi": ["ID7"],
  "requires": { "idrive7-renderd": "2.1.18", "mgu-inputgate": "1.1.0" },
  "autostart": true,
  "signals": {},
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Car profile",
      "buttons": [
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "engine", "label": "Engine", "type": "choice", "default": "app", "options": [["app", "Each app"], ["auto", "Auto (from the car)"], ["diesel", "Diesel"], ["petrol", "Petrol"], ["phev", "Plug-in hybrid (petrol)"]], "group": "Engine"},
    {"key": "redline", "label": "Redline", "type": "number", "unit": "rpm", "default": -1, "labels": {"-1": "Each app", "0": "Auto"}, "steps": [-1, 0, 4000, 4500, 5000, 5500, 5800, 6000, 6200, 6500, 6800, 7000, 7200, 7500, 7800, 8000, 8500, 9000], "group": "Engine"},
    {"key": "shiftAt", "label": "Shift point", "type": "number", "unit": "rpm", "default": -1, "labels": {"-1": "Each app", "0": "Auto (redline - 300)"}, "steps": [-1, 0, 4000, 4500, 5000, 5500, 5800, 6000, 6200, 6500, 6800, 7000, 7200, 7500, 7800, 8000, 8500], "group": "Engine"},
    {"key": "rpmScale", "label": "Rev scale up to", "type": "number", "unit": "rpm", "default": -1, "labels": {"-1": "Each app", "0": "Auto"}, "steps": [-1, 0, 5000, 6000, 7000, 8000, 9000, 10000], "group": "Engine"},
    {"key": "coldLimit", "label": "Cold rev limit", "type": "number", "unit": "rpm", "default": -1, "labels": {"-1": "Each app", "0": "Auto"}, "steps": [-1, 0, 2000, 2500, 3000, 3500, 4000, 4500, 5000, 5500], "group": "Engine"},
    {"key": "lightMode", "label": "Shift lights", "type": "choice", "default": "app", "options": [["app", "Each app"], ["shift", "Shift point"], ["rev", "Rev bar"]], "group": "Engine"},
    {"key": "lightStart", "label": "Rev bar from", "type": "number", "unit": "rpm", "default": -1, "labels": {"-1": "Each app"}, "steps": [-1, 2000, 2500, 3000, 3500, 4000, 4500, 5000, 5500, 6000], "group": "Engine"},
    {"key": "coldGuard", "label": "Cold-engine rev guard", "type": "choice", "default": "app", "options": [["app", "Each app"], ["on", "On"], ["off", "Off"]], "group": "Warm-up"},
    {"key": "warmOil", "label": "Oil is warm at", "type": "number", "unit": "°C", "unitBy": "tempUnit", "units": {"f": {"unit": "°F", "mul": 1.8, "add": 32}}, "default": -1, "labels": {"-1": "Each app"}, "steps": [-1, 60, 70, 75, 80, 85, 90, 100], "group": "Warm-up"},
    {"key": "warmCoolant", "label": "Coolant is warm at", "type": "number", "unit": "°C", "unitBy": "tempUnit", "units": {"f": {"unit": "°F", "mul": 1.8, "add": 32}}, "default": -1, "labels": {"-1": "Each app"}, "steps": [-1, 60, 70, 75, 80, 85, 90], "group": "Warm-up"},
    {"key": "warmGearbox", "label": "Gearbox oil is warm at", "type": "number", "unit": "°C", "unitBy": "tempUnit", "units": {"f": {"unit": "°F", "mul": 1.8, "add": 32}}, "default": -1, "labels": {"-1": "Each app"}, "steps": [-1, 40, 50, 60, 70, 80], "group": "Warm-up"},
    {"key": "hotOil", "label": "Oil is too hot at", "type": "number", "unit": "°C", "unitBy": "tempUnit", "units": {"f": {"unit": "°F", "mul": 1.8, "add": 32}}, "default": -1, "labels": {"-1": "Each app"}, "steps": [-1, 110, 115, 120, 125, 130, 135, 140], "group": "Too hot"},
    {"key": "hotCoolant", "label": "Coolant is too hot at", "type": "number", "unit": "°C", "unitBy": "tempUnit", "units": {"f": {"unit": "°F", "mul": 1.8, "add": 32}}, "default": -1, "labels": {"-1": "Each app"}, "steps": [-1, 110, 115, 120, 125, 130, 135, 140], "group": "Too hot"},
    {"key": "hotGearbox", "label": "Gearbox is too hot at", "type": "number", "unit": "°C", "unitBy": "tempUnit", "units": {"f": {"unit": "°F", "mul": 1.8, "add": 32}}, "default": -1, "labels": {"-1": "Each app"}, "steps": [-1, 80, 85, 90, 95, 100, 105, 110, 115, 120, 125, 130], "group": "Too hot"},
    {"key": "speedUnit", "label": "Speed unit", "type": "choice", "default": "app", "options": [["app", "Each app"], ["kmh", "km/h"], ["mph", "mph"]], "group": "Units"},
    {"key": "distUnit", "label": "Distance unit", "type": "choice", "default": "app", "options": [["app", "Each app"], ["km", "km"], ["mi", "miles"]], "group": "Units"},
    {"key": "tempUnit", "label": "Temperature unit", "type": "choice", "default": "app", "options": [["app", "Each app"], ["c", "Celsius"], ["f", "Fahrenheit"]], "group": "Units"},
    {"key": "pressUnit", "label": "Pressure unit", "type": "choice", "default": "app", "options": [["app", "Each app"], ["bar", "bar"], ["psi", "psi"], ["kpa", "kPa"]], "group": "Units"},
    {"key": "fuelUnit", "label": "Fuel use unit", "type": "choice", "default": "app", "options": [["app", "Each app"], ["l100", "l/100 km"], ["kml", "km/l"], ["mpguk", "mpg (UK)"], ["mpgus", "mpg (US)"]], "group": "Units"},
    {"key": "torqueUnit", "label": "Torque unit", "type": "choice", "default": "app", "options": [["app", "Each app"], ["nm", "Nm"], ["lbft", "lb-ft"], ["kgm", "kgm"]], "group": "Units"},
    {"key": "powerUnit", "label": "Power unit", "type": "choice", "default": "app", "options": [["app", "Each app"], ["hp", "hp"], ["ps", "PS"], ["kw", "kW"]], "group": "Units"},
    {"key": "skin", "label": "Skin", "type": "choice", "default": "app", "options": [["app", "Each app"], ["classic", "Classic"], ["idrive7", "iDrive 7"]], "group": "Display"},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "app", "options": [["app", "Each app"], ["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]], "group": "Display", "when": {"skin": ["app", "classic"]}},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "app", "options": [["app", "Each app"], ["full", "Full screen"], ["standard", "Standard"]], "group": "Display"},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "app", "options": [["app", "Each app"], ["auto", "GPU 60 fps (default)"], ["software", "Software"]], "group": "Display"},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "app", "options": [["app", "Each app"], ["auto", "Auto"], ["on", "Always"], ["off", "Never"]], "group": "Display"},
    {"key": "clock", "label": "Clock", "type": "choice", "default": "app", "options": [["app", "Each app"], ["12", "12-hour"], ["24", "24-hour"]], "group": "Clock"},
    {"key": "timeZone", "label": "Time zone (the clock)", "type": "choice", "default": "app", "options": [["app", "Each app"], ["eastern", "US Eastern"], ["central", "US Central"], ["mountain", "US Mountain"], ["arizona", "Arizona (no DST)"], ["pacific", "US Pacific"], ["alaska", "Alaska"], ["hawaii", "Hawaii"], ["atlantic", "Atlantic"], ["utc", "UTC"], ["uk", "UK / Ireland / Portugal"], ["cet", "Central Europe"], ["eet", "Eastern Europe"], ["utc+9", "Korea / Japan (UTC+9)"]], "group": "Clock"},
    {"key": "tankLitres", "label": "Fuel tank size", "type": "number", "unit": "L", "default": -1, "labels": {"-1": "Each app"}, "steps": [-1, 40, 42, 46, 50, 52, 55, 57, 59, 60, 63, 65, 66, 68, 69, 70, 74, 80, 83, 85, 90], "group": "Fuel and battery"},
    {"key": "eFull", "label": "Electric range when full", "type": "number", "unit": "mi", "default": -1, "labels": {"-1": "Each app"}, "steps": [-1, 20, 22, 24, 26, 28, 30, 31, 32, 34, 36, 38, 40, 45, 50], "group": "Fuel and battery"},
    {"key": "gMax", "label": "G-force circle up to", "type": "number", "unit": "g", "default": -1, "labels": {"-1": "Each app"}, "steps": [-1, 1, 1.2, 1.5, 2], "group": "G-force"}
  ]
}
